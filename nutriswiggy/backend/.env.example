# NutriSwiggy Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Gemini API Key (optional - enables richer AI text)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Swiggy MCP Configuration
SWIGGY_MCP_BASE_URL=https://mcp-staging.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/callback
SWIGGY_CLIENT_ID=your_swiggy_client_id
SWIGGY_CLIENT_SECRET=your_swiggy_client_secret

# Supabase Production Database Configuration
# Get keys from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Token Encryption Key for OAuth Security
# Generate using python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
TOKEN_ENCRYPTION_KEY=your_32_byte_base64_fernet_key

# LLM Provider Configuration (Optional)
# LLM_PROVIDER=gemini
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
