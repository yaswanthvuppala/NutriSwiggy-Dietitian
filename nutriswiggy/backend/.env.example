# NutriSwiggy Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Gemini API Key (optional - enables richer AI text)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Swiggy MCP Configuration
SWIGGY_MCP_BASE_URL=https://mcp-staging.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/callback
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=

# LLM Provider Configuration (Optional)
# LLM_PROVIDER=gemini
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
